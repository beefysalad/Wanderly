generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  imageUrl               String?
  firebaseId             String   @unique
  firebaseDisabled       Boolean  @default(false)
  lastSeenWhatsNew       String?  @default("")
  bio                    String?
  travelStyle            String?
  hasCompletedOnboarding Boolean  @default(false)
  referralSource         String?

  // Relationships
  createdGroups      Group[]          @relation("GroupCreator")
  createdTrips       Trip[]           @relation("TripCreator")
  createdExpenses    Expense[]        @relation("ExpenseCreator")
  groupMemberships   GroupMember[]
  paidExpenses       Expense[]        @relation("ExpensePayer")
  expenseSplits      ExpenseSplit[]
  expensePayments    ExpensePayment[]
  paymentLogsAsPayer PaymentLog[]     @relation("PaymentLogPayer")
  paymentLogsAsPayee PaymentLog[]     @relation("PaymentLogPayee")
  notifications      Notification[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  createdById String
  colorScheme String?  @default("orange")
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  creator       User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members       GroupMember[]
  trips         Trip[]
  expenses      Expense[]
  notifications Notification[] @relation("NotificationGroup")

  @@index([createdById])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  role      String?  @default("member") // "member" | "admin"
  createdAt DateTime @default(now())

  // Relationships
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum TripStatus {
  planning
  finalized
  ongoing
  cancelled
}

model Trip {
  id          String     @id @default(cuid())
  groupId     String
  createdById String? // null once the creator's account is deleted
  name        String
  startDate   DateTime
  endDate     DateTime
  location    String?
  status      TripStatus @default(planning)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  creator       User?          @relation("TripCreator", fields: [createdById], references: [id], onDelete: SetNull)
  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activities    Activity[]
  expenses      Expense[]
  budgets       Budget[]
  paymentLogs   PaymentLog[]
  notifications Notification[] @relation("NotificationTrip")

  @@index([groupId, createdAt])
  @@index([createdById])
}

model Activity {
  id                 String   @id @default(cuid())
  tripId             String
  date               DateTime
  title              String
  startTime          String?
  endTime            String?
  /// Where it happens; the itinerary links it to Google Maps. Max length matches the API schema.
  location           String?  @db.VarChar(200)
  notes              String?
  done               Boolean  @default(false)
  transportationMode String?
  pickupTime         String?
  pickupLocation     String?
  dropoffLocation    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses      Expense[]      @relation("ActivityExpenses")
  budgets       Budget[]       @relation("ActivityBudgets")
  notifications Notification[] @relation("NotificationActivity")

  @@index([tripId, date])
}

enum PaymentMethod {
  cash
  bank
  maya
  gcash
}

model Expense {
  id            String         @id @default(cuid())
  groupId       String
  tripId        String
  paidById      String?
  tempPaidBy    String?
  createdById   String?
  amount        Decimal        @db.Decimal(12, 2)
  description   String
  date          DateTime
  category      String?
  paymentMethod PaymentMethod?
  accountNumber String?
  bankName      String?
  accountName   String?
  qrImage       String?
  activityId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  paidBy        User?            @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  creator       User?            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activity      Activity?        @relation("ActivityExpenses", fields: [activityId], references: [id], onDelete: SetNull)
  splits        ExpenseSplit[]
  payments      ExpensePayment[]
  paymentLogs   PaymentLog[]
  notifications Notification[]   @relation("NotificationExpense")

  @@index([tripId, date])
  @@index([groupId])
  @@index([paidById])
  @@index([createdById])
  @@index([activityId])
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  expenseId String
  userId    String?
  tempName  String?
  createdAt DateTime @default(now())

  // Relationships
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Combined unique constraint might need to be relaxed or changed if we want unique names per expense
  // @@unique([expenseId, userId]) 
  // For now, we allow multiple identical splits if logic permits, or just rely on app logic.
  // But to prevent duplicates for registered users:
  // @@unique([expenseId, userId]) // This fails if userId is null multiple times

  @@index([expenseId])
  @@index([userId])
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

model ExpensePayment {
  id        String        @id @default(cuid())
  expenseId String
  userId    String? // null for a guest split member (tempName identifies them) or once the member's account is deleted
  tempName  String?
  status    PaymentStatus @default(pending)
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  // Relationships
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // userId addresses a registered member's row; tempName addresses a guest's (userId stays null for guests, so it never collides here).
  @@unique([expenseId, userId])
  @@unique([expenseId, tempName])
  @@index([userId])
}

model PaymentLog {
  id            String         @id @default(cuid())
  tripId        String
  expenseId     String
  payerId       String? // null once that account is deleted; payerName/payeeName then keep the name
  payeeId       String?
  payerName     String?
  payeeName     String?
  amount        Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  timestamp     DateTime       @default(now())
  createdAt     DateTime       @default(now())

  // Relationships
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  payer   User?   @relation("PaymentLogPayer", fields: [payerId], references: [id], onDelete: SetNull)
  payee   User?   @relation("PaymentLogPayee", fields: [payeeId], references: [id], onDelete: SetNull)

  // One log per member's share of an expense; a concurrent double-confirm relies on this to no-op instead of duplicating.
  @@unique([expenseId, payerId])
  @@index([tripId, timestamp])
  @@index([payerId])
  @@index([payeeId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 stars
  comment   String
  name      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  payment
  payment_confirmed
  payment_rejected
  group_join
  group_leave
  activity_added
  activity_edited
  activity_deleted
  expense_added
  expense_edited
  expense_deleted
  trip_created
  trip_updated
  trip_deleted
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  read              Boolean          @default(false)
  readAt            DateTime?
  relatedGroupId    String?
  relatedTripId     String?
  relatedExpenseId  String?
  relatedActivityId String?
  createdAt         DateTime         @default(now())

  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedGroup    Group?    @relation("NotificationGroup", fields: [relatedGroupId], references: [id], onDelete: SetNull)
  relatedTrip     Trip?     @relation("NotificationTrip", fields: [relatedTripId], references: [id], onDelete: SetNull)
  relatedExpense  Expense?  @relation("NotificationExpense", fields: [relatedExpenseId], references: [id], onDelete: SetNull)
  relatedActivity Activity? @relation("NotificationActivity", fields: [relatedActivityId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([relatedGroupId])
  @@index([relatedTripId])
  @@index([relatedExpenseId])
  @@index([relatedActivityId])
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Budget {
  id          String   @id @default(cuid())
  tripId      String
  activityId  String? // Optional: Link to a specific activity
  category    String? // e.g. "Food", "Transport"
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  isBooked    Boolean  @default(false) // Whether this is a confirmed price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity Activity? @relation("ActivityBudgets", fields: [activityId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([activityId])
}
