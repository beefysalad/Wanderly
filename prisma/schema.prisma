generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  imageUrl         String?
  firebaseId       String   @unique
  firebaseDisabled Boolean  @default(false)
  lastSeenWhatsNew String?  @default("")
  bio              String?
  travelStyle      String?

  // Relationships
  createdGroups      Group[]          @relation("GroupCreator")
  createdTrips       Trip[]           @relation("TripCreator")
  createdExpenses    Expense[]        @relation("ExpenseCreator")
  groupMemberships   GroupMember[]
  paidExpenses       Expense[]        @relation("ExpensePayer")
  expenseSplits      ExpenseSplit[]
  expensePayments    ExpensePayment[]
  paymentLogsAsPayer PaymentLog[]     @relation("PaymentLogPayer")
  paymentLogsAsPayee PaymentLog[]     @relation("PaymentLogPayee")
  notifications      Notification[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  createdById String
  colorScheme String?  @default("orange")
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  creator       User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members       GroupMember[]
  trips         Trip[]
  expenses      Expense[]
  notifications Notification[] @relation("NotificationGroup")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  role      String?  @default("member") // "member" | "admin"
  createdAt DateTime @default(now())

  // Relationships
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

enum TripStatus {
  planning
  finalized
  ongoing
  cancelled
}

model Trip {
  id          String     @id @default(cuid())
  groupId     String
  createdById String
  name        String
  startDate   DateTime
  endDate     DateTime
  location    String?
  status      TripStatus @default(planning)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  creator       User           @relation("TripCreator", fields: [createdById], references: [id], onDelete: Cascade)
  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activities    Activity[]
  expenses      Expense[]
  paymentLogs   PaymentLog[]
  notifications Notification[] @relation("NotificationTrip")
}

model Activity {
  id                 String   @id @default(cuid())
  tripId             String
  date               DateTime
  title              String
  startTime          String?
  endTime            String?
  notes              String?
  done               Boolean  @default(false)
  transportationMode String?
  pickupTime         String?
  pickupLocation     String?
  dropoffLocation    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses      Expense[]      @relation("ActivityExpenses")
  notifications Notification[] @relation("NotificationActivity")
}

enum PaymentMethod {
  cash
  bank
  maya
  gcash
}

model Expense {
  id            String         @id @default(cuid())
  groupId       String
  tripId        String
  paidById      String
  createdById   String?
  amount        Decimal
  description   String
  date          DateTime
  category      String?
  paymentMethod PaymentMethod?
  accountNumber String?
  bankName      String?
  accountName   String?
  qrImage       String?
  activityId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy        User             @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  creator       User?            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activity      Activity?        @relation("ActivityExpenses", fields: [activityId], references: [id], onDelete: SetNull)
  splits        ExpenseSplit[]
  payments      ExpensePayment[]
  paymentLogs   PaymentLog[]
  notifications Notification[]   @relation("NotificationExpense")
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  createdAt DateTime @default(now())

  // Relationships
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

model ExpensePayment {
  id        String        @id @default(cuid())
  expenseId String
  userId    String
  amount    Decimal       @default(0)
  status    PaymentStatus @default(pending)
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  // Relationships
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model PaymentLog {
  id            String         @id @default(cuid())
  tripId        String
  expenseId     String
  payerId       String
  payeeId       String
  amount        Decimal
  paymentMethod PaymentMethod?
  timestamp     DateTime       @default(now())
  createdAt     DateTime       @default(now())

  // Relationships
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  payer   User    @relation("PaymentLogPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payee   User    @relation("PaymentLogPayee", fields: [payeeId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 stars
  comment   String
  name      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  payment
  payment_confirmed
  payment_rejected
  group_join
  group_leave
  activity_added
  activity_edited
  activity_deleted
  expense_added
  expense_edited
  expense_deleted
  trip_created
  trip_updated
  trip_deleted
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  read              Boolean          @default(false)
  readAt            DateTime?
  relatedGroupId    String?
  relatedTripId     String?
  relatedExpenseId  String?
  relatedActivityId String?
  createdAt         DateTime         @default(now())

  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedGroup    Group?    @relation("NotificationGroup", fields: [relatedGroupId], references: [id], onDelete: SetNull)
  relatedTrip     Trip?     @relation("NotificationTrip", fields: [relatedTripId], references: [id], onDelete: SetNull)
  relatedExpense  Expense?  @relation("NotificationExpense", fields: [relatedExpenseId], references: [id], onDelete: SetNull)
  relatedActivity Activity? @relation("NotificationActivity", fields: [relatedActivityId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
